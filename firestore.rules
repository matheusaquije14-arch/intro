rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.categoria == 'administrador';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isActive() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.activo != false;
    }

    // Perfiles: solo admin escribe; cada usuario lee el suyo; admin lee todos.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Asistencias: el usuario crea únicamente registros propios y no puede
    // modificar ni borrar (trazabilidad). El admin lee todo.
    match /attendance/{id} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Faltas / justificaciones: el usuario crea las suyas; admin aprueba/rechaza.
    match /absences/{id} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Guardias: el aspirante crea la suya (elige su día); admin verifica y gestiona.
    match /guards/{id} {
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Documentos institucionales: todos los activos leen; solo admin escribe.
    match /documents/{id} {
      allow read: if isActive();
      allow write, delete: if isAdmin();
    }

    // Configuración: lectura para usuarios activos; escritura solo admin.
    match /config/{id} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    // Auditoría: solo admin.
    match /audit/{id} {
      allow read, write: if isAdmin();
    }
  }
}
